---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const tagMap = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="標籤" description="所有文章標籤">
  <h1 class="font-sans text-3xl font-bold tracking-tight md:text-4xl">標籤</h1>
  <div class="mt-8 flex flex-wrap gap-3">
    {tags.map(([tag, count]) => (
      <a
        href={`/tags/${tag}`}
        class="text-text/70 no-underline transition-colors duration-200 hover:text-accent"
      >
        #{tag}
        <span class="text-sm text-text/50">({count})</span>
      </a>
    ))}
  </div>
</BaseLayout>

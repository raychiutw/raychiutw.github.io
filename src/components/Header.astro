---
import { SITE_TITLE, NAV_ITEMS } from '../consts';
import ThemeToggle from './ThemeToggle';
import SearchDialog from './SearchDialog';
---

<header class="border-b" style="border-color: var(--border);">
  <div class="mx-auto flex max-w-prose items-center justify-between px-4 py-4">
    <a
      href="/"
      class="flex items-center gap-2 font-sans text-lg font-semibold tracking-wide text-text no-underline"
    >
      <div
        style="width:24px;height:24px;background:#FF9A76;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:12px;font-weight:700;"
      >
        R
      </div>
      {SITE_TITLE.toUpperCase()}
    </a>

    <div class="flex items-center gap-2">
      <nav class="hidden md:flex md:items-center md:gap-6" aria-label="主要導覽">
        {
          NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              class="text-sm text-text/70 no-underline transition-colors duration-200 hover:text-accent"
            >
              {item.title}
            </a>
          ))
        }
      </nav>

      <!-- Search button -->
      <button
        type="button"
        class="ml-2 flex h-10 w-10 items-center justify-center rounded text-text/70 transition-colors duration-200 hover:text-accent"
        aria-label="搜尋"
        data-search-trigger
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </button>

      <!-- Search dialog (React Island) -->
      <SearchDialog client:idle />

      <!-- Theme toggle (React Island) -->
      <ThemeToggle client:idle />

      <!-- Mobile hamburger button -->
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded text-text/70 transition-colors duration-200 hover:text-accent md:hidden"
        aria-label="開啟選單"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          data-menu-icon-open
        >
          <path d="M4 12h16"></path>
          <path d="M4 6h16"></path>
          <path d="M4 18h16"></path>
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden"
          data-menu-icon-close
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav menu -->
  <nav
    class="hidden border-t px-4 pb-4 md:hidden"
    style="border-color: var(--border);"
    aria-label="行動版導覽"
    data-mobile-menu
  >
    {
      NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          class="block py-2 text-sm text-text/70 no-underline transition-colors duration-200 hover:text-accent"
        >
          {item.title}
        </a>
      ))
    }
  </nav>
</header>

<script>
  // Search trigger
  const searchBtn = document.querySelector('[data-search-trigger]');
  searchBtn?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('open-search'));
  });

  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  const iconOpen = document.querySelector('[data-menu-icon-open]');
  const iconClose = document.querySelector('[data-menu-icon-close]');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? '關閉選單' : '開啟選單');
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
